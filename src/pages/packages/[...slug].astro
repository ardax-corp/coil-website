---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { allGroups, packageHref, plainTitle } from "../../lib/nav";

export async function getStaticPaths() {
  const pages = await getCollection("ecosystem");
  return pages.map((page) => ({
    params: { slug: packageHref(page.id).replace(/^\/packages\//, "") },
    props: { page },
  }));
}

type Props = { page: CollectionEntry<"ecosystem"> };
const { page } = Astro.props;
const { Content, headings } = await render(page);
const groups = allGroups(await getCollection("docs"), await getCollection("ecosystem"));
---

<Docs
  href={packageHref(page.id)}
  title={plainTitle(page.data.title)}
  description={page.data.description}
  headings={headings}
  groups={groups}
  source={page.data.source}
>
  <Content />
</Docs>
