---
import Base from "../layouts/Base.astro";
import "../styles/playground.css";
import { playgroundExamples } from "../lib/playground/examples";

const examples = playgroundExamples();
---

<Base
  title="Playground"
  description="Write and run Coil in your browser. The compiler runs locally as WebAssembly; share a program with a link."
  section="playground"
  wide
>
  <div class="pg" data-examples={JSON.stringify(examples)}>
    <div class="pg-bar">
      <select class="pg-examples" aria-label="Load an example">
        <option value="">Examples…</option>
        {examples.map((e) => <option value={e.id}>{e.label}</option>)}
      </select>
      <div class="pg-tabs" role="tablist" aria-label="Files"></div>
      <button class="pg-btn pg-add" type="button" title="Add a file">+ File</button>
      <span class="pg-spacer"></span>
      <button class="pg-btn pg-share" type="button">Share</button>
      <button class="pg-btn primary pg-run" type="button">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4v16l14-8z"></path></svg>
        <span class="pg-run-label">Run</span>
        <kbd>Ctrl ⏎</kbd>
      </button>
    </div>
    <div class="pg-panes">
      <div class="pg-editor" aria-label="Code editor"></div>
      <div class="pg-side">
        <details class="pg-stdin">
          <summary>Standard input</summary>
          <textarea spellcheck="false" placeholder="Text the program reads from stdin"></textarea>
        </details>
        <div class="pg-out"></div>
      </div>
    </div>
    <p class="pg-note">
      Coil runs in your browser as WebAssembly: nothing is sent to a server. Files live in memory for one run. There is
      no network, no FFI, and threads take turns on one core. <a class="pg-chapter" hidden>From the tutorial</a>
    </p>
  </div>
</Base>

<style>
  .pg {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: calc(100vh - var(--header-h));
    margin: 0 auto;
    max-width: 90rem;
    min-height: 32rem;
    padding: 0.9rem var(--gutter) 0.6rem;
  }

  .pg-bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pg-examples {
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--fg-soft);
    font: inherit;
    font-size: 0.8rem;
    padding: 0.36rem 0.5rem;
  }

  .pg-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .pg-tabs :global(.pg-tab) {
    align-items: center;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    gap: 0.3rem;
    padding: 0.35rem 0.55rem;
  }

  .pg-tabs :global(.pg-tab[aria-selected="true"]) {
    background: var(--surface);
    border-color: var(--border);
    color: var(--fg);
  }

  .pg-tabs :global(.pg-tab-close) {
    border-radius: 3px;
    opacity: 0.55;
    padding: 0 0.15rem;
  }

  .pg-tabs :global(.pg-tab-close:hover) {
    background: var(--surface-2);
    opacity: 1;
  }

  .pg-tabs :global(input) {
    background: var(--bg-elev);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.3rem 0.45rem;
    width: 10rem;
  }

  .pg-spacer {
    flex: 1;
  }

  .pg-panes {
    display: grid;
    flex: 1;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    min-height: 0;
  }

  .pg-editor {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius);
    min-height: 0;
    overflow: hidden;
  }

  .pg-editor :global(.cm-editor) {
    height: 100%;
  }

  .pg-side {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 0;
  }

  .pg-stdin summary {
    color: var(--muted);
    cursor: pointer;
    font-size: 0.82rem;
  }

  .pg-stdin textarea {
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-top: 0.4rem;
    min-height: 5rem;
    padding: 0.5rem;
    resize: vertical;
    width: 100%;
  }

  .pg-out {
    flex: 1;
    min-height: 0;
  }

  .pg-out:empty::before {
    color: var(--faint);
  }

  .pg-note {
    color: var(--faint);
    font-size: 0.78rem;
    margin: 0;
  }

  .pg-note a {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .pg {
      height: auto;
    }
    .pg-panes {
      grid-template-columns: minmax(0, 1fr);
    }
    .pg-editor {
      height: 60vh;
    }
    .pg-out {
      min-height: 12rem;
    }
    .pg-btn kbd {
      display: none;
    }
  }
</style>

<script>
  import { createEditor } from "../lib/playground/editor.mjs";
  import { OutputPanel, runInto } from "../lib/playground/output.mjs";
  import { decodeShare, encodeShare } from "../lib/playground/share.mjs";
  import { planRun } from "../lib/playground/plan.mjs";
  import { stop, warmUp } from "../lib/playground/client.mjs";

  type Files = Record<string, string>;
  type Example = { id: string; label: string; chapter: string; files: Files };

  const root = document.querySelector<HTMLElement>(".pg")!;
  const examples: Example[] = JSON.parse(root.dataset.examples!);
  const tabs = root.querySelector<HTMLElement>(".pg-tabs")!;
  const runBtn = root.querySelector<HTMLButtonElement>(".pg-run")!;
  const runLabel = root.querySelector<HTMLElement>(".pg-run-label")!;
  const shareBtn = root.querySelector<HTMLButtonElement>(".pg-share")!;
  const stdinBox = root.querySelector<HTMLTextAreaElement>(".pg-stdin textarea")!;
  const stdinDetails = root.querySelector<HTMLDetailsElement>(".pg-stdin")!;
  const picker = root.querySelector<HTMLSelectElement>(".pg-examples")!;
  const chapterLink = root.querySelector<HTMLAnchorElement>(".pg-chapter")!;
  const panel = new OutputPanel(root.querySelector(".pg-out")!);
  const STORE = "coil-playground";

  let files: Files = {};
  let active = "main.hy";
  let running = false;

  const editor = createEditor(root.querySelector(".pg-editor")!, {
    onRun: () => run(),
    onChange: (text: string) => {
      files[active] = text;
      save();
      updateRunLabel();
    },
  });

  function save() {
    try {
      localStorage.setItem(STORE, JSON.stringify({ files, active, stdin: stdinBox.value }));
    } catch {}
  }

  function updateRunLabel() {
    if (!running) runLabel.textContent = planRun(files).mode === "test" ? "Test" : "Run";
  }

  function load(state: { files: Files; active?: string; stdin?: string }, chapter = "") {
    files = { ...state.files };
    if (!Object.keys(files).length) files = { "main.hy": "" };
    active = state.active && state.active in files ? state.active : Object.keys(files)[0];
    stdinBox.value = state.stdin ?? "";
    stdinDetails.open = !!stdinBox.value;
    chapterLink.hidden = !chapter;
    chapterLink.href = chapter;
    renderTabs();
    editor.value = files[active];
    panel.clear();
    updateRunLabel();
    save();
  }

  function renderTabs() {
    tabs.replaceChildren(
      ...Object.keys(files).map((name) => {
        const tab = document.createElement("button");
        tab.type = "button";
        tab.className = "pg-tab";
        tab.role = "tab";
        tab.setAttribute("aria-selected", String(name === active));
        tab.textContent = name;
        tab.addEventListener("click", () => select(name));
        if (Object.keys(files).length > 1) {
          const close = document.createElement("span");
          close.className = "pg-tab-close";
          close.textContent = "×";
          close.title = `Remove ${name}`;
          close.addEventListener("click", (e) => {
            e.stopPropagation();
            delete files[name];
            if (active === name) active = Object.keys(files)[0];
            renderTabs();
            editor.value = files[active];
            save();
          });
          tab.append(close);
        }
        return tab;
      }),
    );
  }

  function select(name: string) {
    active = name;
    renderTabs();
    editor.value = files[name];
    editor.focus();
    save();
  }

  root.querySelector(".pg-add")!.addEventListener("click", () => {
    const input = document.createElement("input");
    input.placeholder = "util.hy or tests/x.hy";
    input.setAttribute("aria-label", "New file name");
    tabs.append(input);
    input.focus();
    const done = (ok: boolean) => {
      let name = input.value.trim().replace(/^\/+/, "");
      input.remove();
      if (!ok || !name) return;
      if (!name.endsWith(".hy")) name += ".hy";
      if (!(name in files)) files[name] = name.startsWith("tests/") ? 'use tests::assert;\n\ntest("works") {\n    assert!(true);\n}\n' : "";
      select(name);
    };
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") done(true);
      if (e.key === "Escape") done(false);
    });
    input.addEventListener("blur", () => done(true));
  });

  async function run() {
    if (running) {
      stop();
      return;
    }
    running = true;
    runLabel.textContent = "Stop";
    try {
      await runInto(panel, { files, stdin: stdinBox.value });
    } finally {
      running = false;
      updateRunLabel();
    }
  }
  runBtn.addEventListener("click", () => run());
  runBtn.addEventListener("pointerenter", () => warmUp(), { once: true });
  stdinBox.addEventListener("input", save);

  picker.addEventListener("change", () => {
    const ex = examples.find((e) => e.id === picker.value);
    picker.value = "";
    if (!ex) return;
    history.replaceState(null, "", location.pathname);
    load({ files: ex.files }, ex.chapter);
  });

  shareBtn.addEventListener("click", async () => {
    const hash = await encodeShare({ files, stdin: stdinBox.value || undefined });
    history.replaceState(null, "", `#${hash}`);
    try {
      await navigator.clipboard.writeText(location.href);
      shareBtn.textContent = "Link copied";
    } catch {
      shareBtn.textContent = "Link in the address bar";
    }
    setTimeout(() => (shareBtn.textContent = "Share"), 2000);
  });

  async function start() {
    const shared = await decodeShare(location.hash);
    if (shared) return load(shared);
    const example = new URLSearchParams(location.search).get("example");
    const ex = examples.find((e) => e.id === example);
    if (ex) return load({ files: ex.files }, ex.chapter);
    try {
      const saved = JSON.parse(localStorage.getItem(STORE) ?? "null");
      if (saved?.files) return load(saved);
    } catch {}
    load({ files: examples[0].files });
  }
  start();
  warmUp();
</script>
