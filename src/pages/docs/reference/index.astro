---
// Landing page of the Reference track: the language pages, then every module
// of the API reference by section.
import { getCollection } from "astro:content";
import Docs from "../../../layouts/Docs.astro";
import { allGroups, apiRoot, inlineCode, linkHref, moduleItems, referenceGroups, referenceModuleLinks, REFERENCE } from "../../../lib/nav";
import { packages } from "../../../lib/packages";

const reference = await getCollection("reference");
const api = await getCollection("api");
const groups = allGroups(await getCollection("docs"), await getCollection("ecosystem"), reference, api);
// Libraries with a generated API reference of their own, under Packages.
const libraries = [
  { name: "coil-stdlib", key: "stdlib", summary: "The userland standard library: collections, text, numbers, blocking IO." },
  ...packages.map((p) => ({ name: p.name, key: p.name, summary: p.summary })),
].filter((l) => api.some((e) => e.data.package === l.key));
const language = groups.find((g) => g.key === "language")!;
const sections = referenceGroups(reference);
const itemCount = reference.filter((e) => e.data.kind !== "module").length;
const count = (href: string) => {
  const mod = reference.find((e) => e.data.kind === "module" && `${REFERENCE}/${e.id.replace(/\/?index$/, "")}` === href);
  return mod ? moduleItems(reference, mod.data.module).length : 0;
};

const headings = [
  { depth: 2, slug: "language", text: "Language" },
  ...sections.map((s) => ({ depth: 2, slug: s.key, text: s.title })),
  { depth: 2, slug: "libraries", text: "Standard library & packages" },
];
---

<Docs
  href={REFERENCE}
  title="Reference"
  description="Every module, type, function and keyword, one page each, plus the language rules."
  headings={headings}
  groups={groups}
>
  <h1>Reference</h1>
  <p>
    Exact rules and APIs to come back to. The language pages describe syntax and semantics; the API reference has
    one page for each of its {itemCount} types, functions, methods, macros and keywords, generated
    from the documentation comments in the compiler sources. Everything here ships with <code>coil</code> itself;
    coil-stdlib and the packages have API references of their own, <a href="#libraries">listed below</a>. Press
    <kbd>/</kbd> to search by name.
  </p>

  <h2 id="language">Language</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Page</th><th>Contents</th></tr></thead>
      <tbody>
        {
          language.items
            .filter((i) => linkHref(i) !== REFERENCE)
            .map((i) => (
              <tr>
                <td>
                  <a href={linkHref(i)}>{i.label}</a>
                </td>
                <td set:html={inlineCode(i.hint ?? "")} />
              </tr>
            ))
        }
      </tbody>
    </table>
  </div>

  {
    sections.map((s) => (
      <>
        <h2 id={s.key}>{s.title}</h2>
        <p set:html={inlineCode(s.blurb)} />
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Module</th>
                <th>Contents</th>
                <th>Items</th>
              </tr>
            </thead>
            <tbody>
              {referenceModuleLinks(s.items).map((m) => (
                <tr>
                  <td class="mod">
                    <a href={linkHref(m)}>
                      <code>{m.label}</code>
                    </a>
                  </td>
                  <td set:html={inlineCode(m.hint ?? "")} />
                  <td>{count(linkHref(m)) || ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))
  }

  <h2 id="libraries">Standard library &amp; packages</h2>
  <p>
    Not part of the language: ordinary Coil packages a project adds as dependencies in <code>coil.toml</code>. Each has
    its own API reference under <a href="/packages">Packages</a>.
  </p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Library</th><th>Contents</th></tr></thead>
      <tbody>
        {
          libraries.map((l) => (
            <tr>
              <td class="mod">
                <a href={apiRoot(l.key)}>
                  <code>{l.name}</code>
                </a>
              </td>
              <td>{l.summary}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Docs>

<style>
  .mod {
    white-space: nowrap;
  }
</style>
