---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import HeroBackdrop from "../components/HeroBackdrop.astro";
import { LOGOS, BACKGROUNDS } from "../lib/brand";
---

<Base title="Brand options" description="Logo and background options for the Coil site.">
  <section class="wrap intro">
    <span class="eyebrow">Brand options</span>
    <h1>Pick a logo and a background.</h1>
    <p>
      Each option has a <strong>Try it on the site</strong> link. It applies that option on every page until you pick
      another or <a href="/brand?logo=&bg=">reset both</a>. The first logo is the current one, for comparison; E to G
      are the second round, drawn to match the circuit traces. Circuit traces is now the default background. Use the theme toggle in the header to check light and dark.
    </p>
  </section>

  <section class="wrap">
    <h2>Logos</h2>
    <div class="grid">
      {
        LOGOS.map((m, i) => (
          <article class="card">
            <div class="stage">
              <div class="big">
                <Logo only={m.id} size={112} wordmark={false} />
              </div>
              <div class="sizes">
                <Logo only={m.id} size={48} wordmark={false} />
                <Logo only={m.id} size={32} wordmark={false} />
                <Logo only={m.id} size={16} wordmark={false} />
              </div>
            </div>
            <div class="lockups">
              <span class="lockup light"><Logo only={m.id} /></span>
              <span class="lockup dark"><Logo only={m.id} /></span>
            </div>
            <h3>
              {i === 0 ? m.name : `${String.fromCharCode(64 + i)}. ${m.name}`}
            </h3>
            <p>{m.note}</p>
            <a class="try" href={`/?logo=${m.id}`}>Try it on the site →</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <h2>Home page backgrounds</h2>
    <div class="bgs">
      {
        BACKGROUNDS.map((b, i) => (
          <article class="card">
            <div class="mini-hero">
              <HeroBackdrop only={b.id} />
              <div class="mini-copy">
                <strong>A small, statically typed scripting language.</strong>
                <span>Type inference, pattern matching, coroutines and FFI.</span>
              </div>
            </div>
            <h3>{i === 0 ? b.name : `${i}. ${b.name}`}</h3>
            <p>{b.note}</p>
            <a class="try" href={`/?bg=${b.id}`}>Try it on the site →</a>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    padding: 3.5rem 0 1rem;
  }
  .intro h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.04em;
    margin: 0.75rem 0;
  }
  .intro p {
    color: var(--muted);
    max-width: 44rem;
  }
  h2 {
    letter-spacing: -0.03em;
    margin: 2.5rem 0 1rem;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
  .bgs {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    margin-bottom: 4rem;
  }
  .card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }
  .card h3 {
    font-size: 1.05rem;
    margin: 1rem 0 0.3rem;
  }
  .card p {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0 0 0.75rem;
  }
  .try {
    font-size: 0.9rem;
    font-weight: 550;
  }
  .stage {
    align-items: center;
    display: flex;
    gap: 1.25rem;
    justify-content: space-between;
  }
  .sizes {
    align-items: flex-end;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .lockups {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .lockup {
    border-radius: var(--radius);
    padding: 0.6rem 0.8rem;
  }
  .lockup.light {
    --fg: #1d1a15;
    background: #fbf9f5;
    border: 1px solid #e5ded1;
  }
  .lockup.dark {
    --fg: #ede7db;
    background: #100e0b;
    border: 1px solid #2a261f;
  }
  .mini-hero {
    background: var(--glow), var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 15rem;
    overflow: hidden;
    position: relative;
  }
  .mini-copy {
    bottom: 1.25rem;
    display: grid;
    gap: 0.4rem;
    left: 1.25rem;
    max-width: 16rem;
    position: absolute;
  }
  .mini-copy strong {
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .mini-copy span {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
