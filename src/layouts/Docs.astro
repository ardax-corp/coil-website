---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import {
  inlineCode,
  isExternal,
  linkHref,
  locate,
  type NavGroup,
  type NavLink,
  type Track,
} from "../lib/nav";

type Props = {
  /** Site path of this page, e.g. "/docs/references/types". */
  href: string;
  title: string;
  description: string;
  headings: MarkdownHeading[];
  groups: NavGroup[];
  /** Upstream file for pages synced from another repository. */
  source?: string;
};

const { href, title, description, headings, groups, source } = Astro.props;
const here = locate(groups, href);
const sourceRepo = source?.match(/github\.com\/[^/]+\/([^/]+)\/blob\/[0-9a-f]+\/(.+)$/);
const track: Track = here?.group.track ?? "reference";
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const tutorial = groups.find((g) => g.key === "tutorial");

const tracks: { key: Track; label: string }[] = [
  { key: "learn", label: "Learn" },
  { key: "reference", label: "Reference" },
  { key: "packages", label: "Packages" },
];

const pagerTitle = (item: NavLink) => {
  const g = groups.find((g) => g.items.includes(item));
  return g?.track === "packages" && g.items[0] === item ? g.title : item.label;
};

const pagerLabel = (item: NavLink) => {
  const g = groups.find((g) => g.items.includes(item));
  if (g?.key === "tutorial") return `Chapter ${g.items.indexOf(item) + 1}`;
  if (g?.track === "packages") return g.items[0] === item ? "Package" : g.title;
  return g?.title ?? "";
};
---

<Base title={title} description={description} section={track} wide>
  <div class="docs">
    <aside class="sidebar" id="docs-sidebar" aria-label="Documentation">
      <div class="sidebar-inner">
        <div class="track-tabs" role="tablist">
          {
            tracks.map((t) => (
              <button
                type="button"
                role="tab"
                aria-selected={t.key === track ? "true" : "false"}
                aria-controls={`track-${t.key}`}
                data-track={t.key}
              >
                {t.label}
              </button>
            ))
          }
        </div>

        {
          tracks.map((t) => (
            <div class="track" id={`track-${t.key}`} role="tabpanel" hidden={t.key !== track}>
              {groups
                .filter((g) => g.track === t.key)
                .map((g) => {
                  const links = (
                    <ul>
                      {g.items.map((item, i) => (
                        <li>
                          <a
                            href={linkHref(item)}
                            aria-current={!isExternal(item) && linkHref(item) === href ? "page" : undefined}
                            class:list={[{ external: isExternal(item) }]}
                          >
                            {g.key === "tutorial" && <span class="num">{String(i + 1).padStart(2, "0")}</span>}
                            <span>{item.label}</span>
                            {isExternal(item) && <span class="ext" aria-label="(external)">↗</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  );
                  // Packages are many small groups: collapse all but the current one.
                  return g.track === "packages" ? (
                    <details class="nav-group collapsible" open={g === here?.group}>
                      <summary>{g.title}</summary>
                      {links}
                    </details>
                  ) : (
                    <section class="nav-group">
                      <h2>{g.title}</h2>
                      {links}
                    </section>
                  );
                })}
            </div>
          ))
        }
      </div>
    </aside>

    <div class="docs-main">
      <div class="docs-bar">
        <button class="sidebar-toggle" type="button" aria-controls="docs-sidebar" aria-expanded="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h10M4 18h16"></path>
          </svg>
          Menu
        </button>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/docs">Docs</a>
          <span aria-hidden="true">/</span>
          {here && <span class="crumb-group">{here.group.title}</span>}
          {here && <span class="crumb-group" aria-hidden="true">/</span>}
          <span aria-current="page">{here?.item.label ?? title}</span>
        </nav>
      </div>

      {
        here?.chapter && tutorial && (
          <div class="chapter">
            <div class="chapter-meta">
              <span class="eyebrow">
                Chapter {here.chapter} of {here.chapters}
              </span>
            </div>
            <ol class="chapter-track" aria-label="Tutorial chapters">
              {tutorial.items.map((c, i) => (
                <li>
                  <a
                    href={linkHref(c)}
                    title={`${i + 1}. ${c.label}`}
                    class:list={{ done: i + 1 < here.chapter!, current: i + 1 === here.chapter }}
                  >
                    <span class="sr-only">
                      Chapter {i + 1}: {c.label}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      <article class="prose">
        <slot />
      </article>

      {
        sourceRepo && (
          <p class="source">
            Synced from{" "}
            <a href={source}>
              <code>
                {sourceRepo[1]}/{sourceRepo[2]}
              </code>
            </a>
            . Edit it there; changes reach this site on the next package sync.
          </p>
        )
      }

      {
        (here?.prev || here?.next) && (
          <nav class="pager" aria-label="Pagination">
            {here.prev ? (
              <a class="pager-link prev" href={linkHref(here.prev)}>
                <span class="pager-dir">← Previous · {pagerLabel(here.prev)}</span>
                <span class="pager-title">{pagerTitle(here.prev)}</span>
              </a>
            ) : (
              <span />
            )}
            {here.next && (
              <a class="pager-link next" href={linkHref(here.next)}>
                <span class="pager-dir">Next · {pagerLabel(here.next)} →</span>
                <span class="pager-title">{pagerTitle(here.next)}</span>
                {here.next.hint && <span class="pager-hint" set:html={inlineCode(here.next.hint)} />}
              </a>
            )}
          </nav>
        )
      }
    </div>

    <aside class="toc" aria-label="On this page">
      {
        toc.length > 1 && (
          <div class="toc-inner">
            <h2>On this page</h2>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`} data-slug={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
            <a class="toc-top" href="#main">
              Back to top ↑
            </a>
          </div>
        )
      }
    </aside>
  </div>
  <div class="sidebar-scrim" hidden></div>
</Base>

<script>
  // Learn / Reference tabs in the sidebar.
  const tabs = document.querySelectorAll<HTMLButtonElement>(".track-tabs [role=tab]");
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        document.getElementById(`track-${t.dataset.track}`)!.hidden = !on;
      });
    }),
  );

  // Keep the current page visible in a long sidebar.
  const current = document.querySelector<HTMLElement>(".sidebar [aria-current=page]");
  const inner = document.querySelector<HTMLElement>(".sidebar-inner");
  if (current && inner) inner.scrollTop = current.offsetTop - inner.clientHeight / 2;

  // Mobile drawer.
  const sidebar = document.getElementById("docs-sidebar")!;
  const toggle = document.querySelector<HTMLButtonElement>(".sidebar-toggle")!;
  const scrim = document.querySelector<HTMLElement>(".sidebar-scrim")!;
  const setDrawer = (open: boolean) => {
    sidebar.classList.toggle("open", open);
    scrim.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle.addEventListener("click", () => setDrawer(!sidebar.classList.contains("open")));
  scrim.addEventListener("click", () => setDrawer(false));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setDrawer(false));

  // Scroll-spy for "On this page".
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>(".toc a[data-slug]").forEach((a) => links.set(a.dataset.slug!, a));
  const targets = [...links.keys()].map((s) => document.getElementById(s)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    let queued = false;
    const mark = () => {
      queued = false;
      let active = targets[0].id;
      for (const t of targets) {
        if (t.getBoundingClientRect().top < 140) active = t.id;
      }
      links.forEach((a, slug) => a.classList.toggle("active", slug === active));
    };
    addEventListener(
      "scroll",
      () => {
        if (!queued) requestAnimationFrame(mark);
        queued = true;
      },
      { passive: true },
    );
    mark();
  }
</script>

<style>
  .docs {
    display: grid;
    gap: 3rem;
    grid-template-columns: 16rem minmax(0, 1fr) 13rem;
    margin: 0 auto;
    max-width: 90rem;
    padding: 0 var(--gutter);
  }

  /* ------------------------------------------------------------ sidebar */

  .sidebar {
    border-right: 1px solid var(--border);
    height: calc(100vh - var(--header-h));
    margin-right: -1.5rem;
    position: sticky;
    top: var(--header-h);
  }

  .sidebar-inner {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.75rem 1.25rem 3rem 0;
    scrollbar-width: thin;
  }

  .track-tabs {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 1.5rem;
    padding: 3px;
  }

  .track-tabs button {
    background: none;
    border: 0;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 500;
    padding: 0.4rem 0;
    transition: color 0.15s, background 0.15s;
  }

  .track-tabs button[aria-selected="true"] {
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    color: var(--fg);
  }

  .nav-group + .nav-group {
    margin-top: 1.6rem;
  }

  .nav-group h2 {
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem 0.65rem;
    text-transform: uppercase;
  }

  .collapsible + .collapsible {
    margin-top: 0.15rem;
  }

  .collapsible summary {
    align-items: center;
    border-radius: var(--radius-sm);
    color: var(--fg-soft);
    cursor: pointer;
    display: flex;
    font-size: 0.9rem;
    font-weight: 500;
    gap: 0.5rem;
    list-style: none;
    padding: 0.36rem 0.65rem;
    transition: background 0.12s, color 0.12s;
  }

  .collapsible summary::-webkit-details-marker {
    display: none;
  }

  .collapsible summary::before {
    border-bottom: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    color: var(--faint);
    content: "";
    height: 0.4rem;
    transform: rotate(-45deg);
    transition: transform 0.15s;
    width: 0.4rem;
  }

  .collapsible[open] summary::before {
    transform: rotate(45deg);
  }

  .collapsible summary:hover {
    background: var(--surface);
    color: var(--fg);
  }

  .collapsible ul {
    border-left: 1px solid var(--border);
    margin: 0.15rem 0 0.4rem 0.95rem;
    padding-left: 0.35rem;
  }

  .nav-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-group a {
    align-items: baseline;
    border-radius: var(--radius-sm);
    color: var(--muted);
    display: flex;
    font-size: 0.9rem;
    gap: 0.55rem;
    line-height: 1.4;
    padding: 0.36rem 0.65rem;
    text-decoration: none;
    transition: color 0.12s, background 0.12s;
  }

  .nav-group a:hover {
    background: var(--surface);
    color: var(--fg);
  }

  .nav-group a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }

  .nav-group .num {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .nav-group a[aria-current="page"] .num {
    color: inherit;
  }

  .nav-group .ext {
    color: var(--faint);
    font-size: 0.75rem;
    margin-left: auto;
  }

  /* --------------------------------------------------------------- main */

  .docs-main {
    min-width: 0;
    padding: 2rem 0 2rem;
  }

  .docs-bar {
    align-items: center;
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .sidebar-toggle {
    align-items: center;
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg);
    cursor: pointer;
    display: none;
    flex: none;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
  }

  .crumbs {
    align-items: center;
    color: var(--faint);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.5rem;
    min-width: 0;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .crumbs [aria-current] {
    color: var(--fg-soft);
  }

  .chapter {
    margin-bottom: 1.25rem;
    max-width: var(--measure);
  }

  .chapter-meta {
    margin-bottom: 0.6rem;
  }

  .chapter-track {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chapter-track li {
    flex: 1;
  }

  .chapter-track a {
    background: var(--surface-2);
    border-radius: 2px;
    display: block;
    height: 4px;
    transition: background 0.15s, transform 0.15s;
  }

  .chapter-track a:hover {
    background: var(--border-strong);
    transform: scaleY(1.8);
  }

  .chapter-track a.done {
    background: color-mix(in srgb, var(--accent) 45%, var(--surface-2));
  }

  .chapter-track a.current {
    background: var(--accent);
  }

  .source {
    border-top: 1px dashed var(--border);
    color: var(--faint);
    font-size: 0.85rem;
    margin-top: 3rem;
    max-width: var(--measure);
    padding-top: 1rem;
  }

  .source a {
    color: var(--muted);
  }

  .source a:hover {
    color: var(--accent);
  }

  .source code {
    font-size: 0.92em;
  }

  /* ---------------------------------------------------------------- pager */

  .pager {
    border-top: 1px solid var(--border);
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
    margin-top: 4rem;
    max-width: var(--measure);
    padding-top: 2rem;
  }

  .pager-link {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.2rem;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .pager-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .pager-link.next {
    grid-column: 2;
    text-align: right;
  }

  .pager-dir {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .pager-title {
    color: var(--fg);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .pager-link:hover .pager-title {
    color: var(--accent);
  }

  .pager-hint {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .pager-hint :global(code) {
    font-size: 0.9em;
  }

  /* ------------------------------------------------------------------ toc */

  .toc-inner {
    max-height: calc(100vh - var(--header-h) - 2rem);
    overflow-y: auto;
    padding: 2.4rem 0 2rem;
    position: sticky;
    scrollbar-width: thin;
    top: var(--header-h);
  }

  .toc h2 {
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .toc ul {
    border-left: 1px solid var(--border);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc a {
    border-left: 2px solid transparent;
    color: var(--muted);
    display: block;
    font-size: 0.83rem;
    line-height: 1.4;
    margin-left: -1px;
    padding: 0.28rem 0 0.28rem 0.85rem;
    text-decoration: none;
    transition: color 0.12s, border-color 0.12s;
  }

  .toc .d3 a {
    font-size: 0.8rem;
    padding-left: 1.6rem;
  }

  .toc a:hover {
    color: var(--fg);
  }

  .toc a.active {
    border-left-color: var(--accent);
    color: var(--accent);
  }

  .toc-top {
    color: var(--faint);
    display: inline-block;
    font-size: 0.8rem;
    margin-top: 1rem;
    text-decoration: none;
  }

  .toc-top:hover {
    color: var(--accent);
  }

  /* ----------------------------------------------------------- responsive */

  @media (max-width: 1240px) {
    .docs {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .docs {
      display: block;
    }

    .sidebar {
      background: var(--bg);
      border-right: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      height: 100dvh;
      left: 0;
      margin: 0;
      max-width: 85vw;
      position: fixed;
      top: 0;
      transform: translateX(-105%);
      transition: transform 0.22s ease;
      width: 19rem;
      z-index: 60;
    }

    .sidebar.open {
      transform: none;
    }

    .sidebar-inner {
      padding: 1.25rem 1rem 3rem;
    }

    .sidebar-scrim {
      background: rgb(16 14 11 / 0.45);
      inset: 0;
      position: fixed;
      z-index: 55;
    }

    .sidebar-toggle {
      display: inline-flex;
    }

    .docs-main {
      padding-top: 1.25rem;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      grid-column: 1;
      grid-row: 1;
    }
    .crumbs .crumb-group {
      display: none;
    }
  }
</style>
