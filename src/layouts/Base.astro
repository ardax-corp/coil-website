---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/prose.css";
import Logo from "../components/Logo.astro";
import Search from "../components/Search.astro";
import { REPO, RELEASES, SPOOL, STDLIB, INTERNALS } from "../lib/nav";

export type Section = "home" | "docs" | "learn" | "reference" | "packages" | "blog" | "none";

type Props = {
  title: string;
  description: string;
  ogImage?: string;
  section?: Section;
  /** Match the wider docs grid instead of the standard page width. */
  wide?: boolean;
};

const { title, description, ogImage = "/og-home.png", section = "none", wide = false } = Astro.props;
const canonicalTitle = title === "Coil" ? "Coil — a small, statically typed scripting language" : `${title} · Coil`;

const nav: { href: string; label: string; key: Section }[] = [
  { href: "/docs", label: "Docs", key: "docs" },
  { href: "/docs/manual/getting-started", label: "Learn", key: "learn" },
  { href: "/docs/references", label: "Reference", key: "reference" },
  { href: "/packages", label: "Packages", key: "packages" },
  { href: "/blog", label: "Blog", key: "blog" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100e0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={canonicalTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{canonicalTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["site-header", { wide }]}>
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Coil home"><Logo /></a>

        <nav class="primary-nav" aria-label="Site">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={section === n.key ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>

        <div class="header-tools">
          <button class="search-trigger" type="button" data-search-open aria-label="Search docs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
            </svg>
            <span class="search-label">Search</span>
            <kbd class="search-kbd">/</kbd>
          </button>
          <a class="icon-btn" href={REPO} aria-label="Coil on GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
            </svg>
          </a>
          <button class="icon-btn theme-toggle" type="button" aria-label="Toggle colour theme">
            <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
            </svg>
          </button>
          <button class="icon-btn menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Site" hidden>
        <div class="wrap">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={section === n.key ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
          <a href={REPO}>GitHub</a>
        </div>
      </nav>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <Logo size={24} />
          <p>A small, statically typed scripting language with a thin bytecode VM.</p>
        </div>
        <div>
          <h2>Learn</h2>
          <a href="/docs/manual/getting-started">Getting started</a>
          <a href="/docs/manual/tutorial/01-basics">Tutorial</a>
          <a href="/docs/manual/examples">Examples</a>
          <a href="/docs/overview">Overview</a>
        </div>
        <div>
          <h2>Reference</h2>
          <a href="/docs/references/syntax">Syntax</a>
          <a href="/docs/references/types">Types</a>
          <a href="/docs/references">All references</a>
          <a href="/docs/references/error-codes">Error codes</a>
        </div>
        <div>
          <h2>Ecosystem</h2>
          <a href="/packages">Packages</a>
          <a href={STDLIB}>coil-stdlib</a>
          <a href={SPOOL}>spool</a>
          <a href={INTERNALS}>Internals</a>
        </div>
        <div>
          <h2>Project</h2>
          <a href={REPO}>GitHub</a>
          <a href={RELEASES}>Releases</a>
          <a href="/blog">Blog</a>
        </div>
      </div>
      <div class="wrap footer-base">
        <span><code>.hy</code> — henry, the unit of inductance. The measure of a coil.</span>
      </div>
    </footer>

    <Search />

    <script>
      // Theme toggle: flips between light/dark and remembers the explicit choice.
      const root = document.documentElement;
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const current =
          root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });

      // Mobile menu.
      const menuBtn = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const mobileNav = document.getElementById("mobile-nav");
      menuBtn?.addEventListener("click", () => {
        const open = menuBtn.getAttribute("aria-expanded") === "true";
        menuBtn.setAttribute("aria-expanded", String(!open));
        mobileNav!.hidden = open;
      });

      // Code blocks: language label + copy button.
      document.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-frame") || pre.closest("[data-plain-code]")) return;
        const frame = document.createElement("div");
        frame.className = "code-frame";
        pre.replaceWith(frame);
        frame.append(pre);

        const lang = pre.dataset.language;
        if (lang && lang !== "plaintext") {
          const label = document.createElement("span");
          label.className = "code-lang";
          label.textContent = lang;
          frame.append(label);
        }

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.textContent = "Copy";
        btn.addEventListener("click", async () => {
          await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""));
          btn.textContent = "Copied";
          btn.dataset.copied = "";
          setTimeout(() => {
            btn.textContent = "Copy";
            delete btn.dataset.copied;
          }, 1600);
        });
        frame.append(btn);
      });
    </script>
  </body>
</html>

<style>
  .skip {
    background: var(--accent);
    border-radius: var(--radius-sm);
    color: var(--accent-ink);
    left: 1rem;
    padding: 0.5rem 0.8rem;
    position: fixed;
    top: -4rem;
    z-index: 100;
  }
  .skip:focus {
    top: 0.75rem;
  }

  .site-header {
    backdrop-filter: saturate(1.4) blur(12px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .site-header.wide .wrap {
    max-width: 90rem;
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: 2rem;
    height: var(--header-h);
  }

  .brand {
    flex: none;
    text-decoration: none;
  }

  .primary-nav {
    display: flex;
    gap: 0.25rem;
  }

  .primary-nav a,
  .mobile-nav a {
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.93rem;
    font-weight: 500;
    padding: 0.4rem 0.8rem;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }

  .primary-nav a:hover {
    color: var(--fg);
  }

  .primary-nav a[aria-current="page"] {
    background: var(--surface);
    color: var(--fg);
  }

  .header-tools {
    align-items: center;
    display: flex;
    gap: 0.4rem;
    margin-left: auto;
  }

  .search-trigger {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    font: inherit;
    font-size: 0.88rem;
    gap: 0.5rem;
    margin-right: 0.35rem;
    padding: 0.4rem 0.5rem 0.4rem 0.8rem;
    transition: border-color 0.15s, color 0.15s;
    width: 13rem;
  }

  .search-trigger:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .search-label {
    flex: 1;
    text-align: left;
  }

  .icon-btn {
    align-items: center;
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    height: 2.25rem;
    justify-content: center;
    transition: color 0.15s, background 0.15s;
    width: 2.25rem;
  }

  .icon-btn:hover {
    background: var(--surface);
    color: var(--fg);
  }

  .i-moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .i-moon {
      display: block;
    }
  }

  .menu-toggle {
    display: none;
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    padding: 0.75rem 0 1rem;
  }

  .mobile-nav .wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .mobile-nav a {
    border-radius: var(--radius);
    font-size: 1rem;
    padding: 0.65rem 0.8rem;
  }

  .mobile-nav a[aria-current="page"] {
    background: var(--surface);
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .primary-nav {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .search-trigger {
      width: auto;
    }
  }

  @media (max-width: 520px) {
    .search-trigger {
      background: none;
      border-color: transparent;
      margin: 0;
      padding: 0;
      height: 2.25rem;
      justify-content: center;
      width: 2.25rem;
    }
    .search-label,
    .search-kbd {
      display: none;
    }
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    padding-bottom: 2.5rem;
    padding-top: 3.5rem;
  }

  .footer-grid h2 {
    color: var(--fg);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin: 0 0 0.85rem;
    text-transform: uppercase;
  }

  .footer-grid div > a {
    display: block;
    padding: 0.2rem 0;
    text-decoration: none;
    width: fit-content;
  }

  .footer-grid a:hover {
    color: var(--accent);
  }

  .footer-brand p {
    margin: 0.85rem 0 0;
    max-width: 18rem;
  }

  .footer-base {
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.82rem;
    padding-bottom: 1.75rem;
    padding-top: 1.25rem;
  }

  .footer-base code {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
