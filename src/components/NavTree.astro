---
// One sidebar list. Links nested under a page (API items under their module)
// show only while a page inside it is open; nested modules (io → io::fs) get a
// disclosure toggle so the tree can be browsed without leaving the page.
import { isExternal, linkHref, type NavLink } from "../lib/nav";

type Props = {
  items: NavLink[];
  /** Site path of the current page. */
  href: string;
  /** Number the links (tutorial chapters). */
  numbered?: boolean;
  nested?: boolean;
};
const { items, href, numbered = false, nested = false } = Astro.props;

const inside = (item: NavLink) => href === linkHref(item) || href.startsWith(`${linkHref(item)}/`);
---

<ul class:list={["nav-tree", { "nav-children": nested }]}>
  {
    items.map((item, i) => {
      const subs = item.children?.filter((c) => c.module) ?? [];
      const leaves = inside(item) ? (item.children?.filter((c) => !c.module) ?? []) : [];
      // Nested entries are API items whose member pages sit below them.
      const current = !isExternal(item) && (nested && !item.module ? inside(item) : linkHref(item) === href);
      const link = (
        <a href={linkHref(item)} aria-current={current ? "page" : undefined} class:list={{ external: isExternal(item) }}>
          {numbered && <span class="num">{String(i + 1).padStart(2, "0")}</span>}
          {nested ? <code>{item.short ?? item.label}</code> : <span>{item.label}</span>}
          {isExternal(item) && (
            <span class="ext" aria-label="(external)">
              ↗
            </span>
          )}
        </a>
      );
      const children = (subs.length > 0 || leaves.length > 0) && (
        <Astro.self items={[...subs, ...leaves]} href={href} nested />
      );
      return subs.length > 0 ? (
        <li>
          <details class="nav-mod" open={inside(item)}>
            <summary>{link}</summary>
            {children}
          </details>
        </li>
      ) : (
        <li>
          {link}
          {children}
        </li>
      );
    })
  }
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    align-items: baseline;
    border-radius: var(--radius-sm);
    color: var(--muted);
    display: flex;
    flex: 1;
    font-size: 0.9rem;
    gap: 0.55rem;
    line-height: 1.4;
    min-width: 0;
    padding: 0.36rem 0.65rem;
    text-decoration: none;
    transition: color 0.12s, background 0.12s;
  }

  a:hover {
    background: var(--surface);
    color: var(--fg);
  }

  a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 500;
  }

  .nav-children {
    border-left: 1px solid var(--border);
    margin: 0.15rem 0 0.4rem 0.75rem;
    padding-left: 0.4rem;
  }

  .nav-children a {
    font-size: 0.82rem;
    padding-block: 0.15rem;
  }

  code {
    background: none;
    border: 0;
    font-size: inherit;
    overflow-wrap: anywhere;
    padding: 0;
  }

  .num {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  a[aria-current="page"] .num {
    color: inherit;
  }

  .ext {
    color: var(--faint);
    font-size: 0.75rem;
    margin-left: auto;
  }

  /* A module with submodules: the link, then a chevron that folds them. */
  summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    border-bottom: 1.5px solid var(--faint);
    border-right: 1.5px solid var(--faint);
    content: "";
    flex: none;
    height: 0.38rem;
    margin: 0 0.7rem 0 0.4rem;
    transform: rotate(-45deg);
    transition: transform 0.15s;
    width: 0.38rem;
  }

  details[open] > summary::after {
    transform: rotate(45deg);
  }

  summary:hover::after {
    border-color: var(--fg);
  }
</style>
