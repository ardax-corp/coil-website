---
import { MARK_SVG } from "../lib/logo";

type Props = { size?: number; wordmark?: boolean };
const { size = 28, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" set:html={MARK_SVG} />
  {wordmark && <span class="logo-word">coil</span>}
</span>

<style>
  .logo {
    align-items: center;
    display: inline-flex;
    gap: 0.55rem;
  }
  .logo :global(.mark-tile) {
    fill: #18150f;
  }
  .logo :global(.mark-ink) {
    stroke: #eb8a52;
  }
  .logo :global(.mark-ink2) {
    stroke: #7fc8b6;
  }
  .logo :global(.mark-pad) {
    fill: #18150f;
    stroke: #7fc8b6;
    stroke-width: 1.5;
  }
  .logo-word {
    color: var(--fg);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
</style>
