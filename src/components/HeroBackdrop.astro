---
import { TRACES_SVG } from "../lib/logo";
---

<div class="backdrop" aria-hidden="true" set:html={TRACES_SVG} />

<style>
  .backdrop {
    color: color-mix(in srgb, var(--accent) 16%, transparent);
    inset: 0;
    mask-image: linear-gradient(100deg, transparent 35%, #000 65%);
    overflow: hidden;
    pointer-events: none;
    position: absolute;
  }
  .backdrop :global(svg) {
    height: 100%;
    width: 100%;
  }
</style>
