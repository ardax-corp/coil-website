---
import { BACKGROUNDS } from "../lib/brand";
import { COIL_PATH } from "../lib/logo";

/** Decorative hero background; `only` pins one variant (used by /brand). */
type Props = { only?: string };
const { only } = Astro.props;
const list = only ? BACKGROUNDS.filter((b) => b.id === only) : BACKGROUNDS;
---

<div class:list={["backdrop", { pinned: only }]} aria-hidden="true">
  {
    list.map((b) =>
      b.id === "current" ? (
        <svg class="bd bd-current" data-bg="current" viewBox="0 0 32 32" preserveAspectRatio="none">
          <path d={COIL_PATH} fill="none" stroke="currentColor" stroke-width="0.35" stroke-linecap="round" />
        </svg>
      ) : b.svg ? (
        <div class={`bd bd-${b.id}`} data-bg={b.id} set:html={b.svg} />
      ) : (
        <div class={`bd bd-${b.id}`} data-bg={b.id} />
      ),
    )
  }
</div>

<style is:global>
  .backdrop {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
  }
  .backdrop .bd {
    display: none;
    inset: 0;
    position: absolute;
  }
  .backdrop.pinned .bd,
  :root:not([data-bg]) .backdrop .bd[data-bg="current"],
  :root[data-bg="current"] .backdrop .bd[data-bg="current"],
  :root[data-bg="dots"] .backdrop .bd[data-bg="dots"],
  :root[data-bg="field"] .backdrop .bd[data-bg="field"],
  :root[data-bg="traces"] .backdrop .bd[data-bg="traces"],
  :root[data-bg="blueprint"] .backdrop .bd[data-bg="blueprint"],
  :root[data-bg="sheen"] .backdrop .bd[data-bg="sheen"] {
    display: block;
  }

  .backdrop .bd-current {
    color: var(--accent);
    height: 140%;
    left: -10%;
    opacity: 0.07;
    top: -20%;
    width: 120%;
  }

  .backdrop .bd-dots {
    background-image: radial-gradient(circle, color-mix(in srgb, var(--fg) 22%, transparent) 1px, transparent 1.6px);
    background-size: 22px 22px;
    mask-image: radial-gradient(70% 90% at 85% 40%, #000 0%, transparent 75%);
  }

  .backdrop .bd-field {
    background-image: repeating-radial-gradient(
      circle at 92% 8%,
      transparent 0 46px,
      color-mix(in srgb, var(--accent) 22%, transparent) 46px 47.5px
    );
    mask-image: radial-gradient(80% 110% at 92% 8%, #000 10%, transparent 80%);
  }

  .backdrop .bd-traces {
    color: color-mix(in srgb, var(--accent) 16%, transparent);
    mask-image: linear-gradient(100deg, transparent 35%, #000 65%);
  }
  .backdrop .bd-traces svg {
    height: 100%;
    width: 100%;
  }

  .backdrop .bd-blueprint {
    --line: color-mix(in srgb, var(--patina) 14%, transparent);
    --major: color-mix(in srgb, var(--patina) 24%, transparent);
    background-image:
      linear-gradient(var(--major) 1px, transparent 1px),
      linear-gradient(90deg, var(--major) 1px, transparent 1px),
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-position: -1px -1px;
    background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px;
    mask-image: radial-gradient(75% 100% at 80% 30%, #000 0%, transparent 78%);
  }

  .backdrop .bd-sheen {
    background:
      radial-gradient(45% 70% at 82% 18%, color-mix(in srgb, var(--accent) 26%, transparent), transparent 70%),
      radial-gradient(40% 60% at 60% 95%, color-mix(in srgb, var(--patina) 20%, transparent), transparent 70%),
      radial-gradient(30% 50% at 8% 10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
    filter: blur(8px);
  }
</style>
